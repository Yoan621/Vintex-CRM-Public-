# Configuration du backend Vintex CRM

# Port du serveur
PORT=3001

# Token d'authentification pour l'API
# Générez un token sécurisé avec : openssl rand -hex 32
API_TOKEN=votre-token-secret-ici

# URL de la base de données (exemple)
# DATABASE_URL=postgresql://user:password@localhost:5432/vintex_crm

# Environnement
NODE_ENV=development
